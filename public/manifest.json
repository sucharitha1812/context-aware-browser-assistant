{
  "manifest_version": 3,
  "name": "Context-Aware Browser Assistant",
  "version": "1.0",
  "description": "AI assistant that understands webpage context",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "contextMenus", "notifications"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:11434/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "Context-Aware Browser Assistant"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"]
    }
  ]
}